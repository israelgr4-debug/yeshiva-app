{
  "name": "PROJECT_NAME_HERE",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "//": "Pick the right base image for your stack:",
  "//": "  - typescript-node:1-20-bookworm    (Next.js / React / Node)",
  "//": "  - python:1-3.11-bookworm           (Python / Django / Flask)",
  "//": "  - go:1-1.21-bookworm               (Go services)",
  "//": "  - universal:2                       (multi-language)",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "//": "Customize what runs after the container is built. Common patterns:",
  "//": "  Node:    'npm install'",
  "//": "  Python:  'pip install -r requirements.txt'",
  "//": "  Both:    'npm install && pip install -r requirements.txt'",
  "postCreateCommand": "npm install",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },

  "//": "Ports your dev server uses",
  "forwardPorts": [3000]
}
